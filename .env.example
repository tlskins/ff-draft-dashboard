# Optional read-only API. When omitted or unavailable, the dashboard uses its
# embedded rankings. Production should point this to the stateless Cloud Run
# API, for example https://drafty-api-<hash>-uc.a.run.app.
NEXT_PUBLIC_API_HOST=http://127.0.0.1:5000
NEXT_PUBLIC_HISTORICAL_COMPARISON_ENABLED=false

# Read-only API access never enables browser-state writes for a public host.
# The three mutation boundaries retain their existing defaults for the
# loopback API above. For production, set each explicitly to false:
# NEXT_PUBLIC_DRAFT_SESSION_PERSISTENCE_ENABLED=false
# NEXT_PUBLIC_ADVISOR_SNAPSHOT_PERSISTENCE_ENABLED=false
# NEXT_PUBLIC_RANKING_PROFILE_PERSISTENCE_ENABLED=false
# Do not enable them until the API has authenticated write endpoints and
# durable storage.

# Optional authenticated, cross-device sync for canonical rankings and player
# targets. These Firebase Web values are public identifiers, not secrets. The
# companion API must enable USER_PROFILE_PERSISTENCE_ENABLED separately.
NEXT_PUBLIC_CLOUD_PROFILE_SYNC_ENABLED=false
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Realtime is deferred and always requires an explicit browser opt-in. It also
# requires the companion API to be configured to mint client secrets. Omit it
# (the default) or set NEXT_PUBLIC_REALTIME_ADVISOR_ENABLED=false.
