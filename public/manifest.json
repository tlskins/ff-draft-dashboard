{
  "manifest_version": 3,

  "name": "FF Draft Pulse (Local Dev)",
  "description": "Local development build for the Drafty fantasy football dashboard",
  "version": "0.0.0.8",
  "icons": {
    "16": "pulse-icon-16.png",
    "32": "pulse-icon-32.png",
    "128": "pulse-icon-128.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
      {
          "matches": [
            "https://ff-draft-dashboard.vercel.app/*",
            "https://fantasy.espn.com/football/draft*",
            "https://fantasy.nfl.com/draftclient*",
            "http://localhost:3000/*"
          ],
          "js": [
            "espnDraftExtractor.js",
            "contentScript.js"
          ]
      }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  }
}
