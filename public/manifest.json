{
  "manifest_version": 3,

  "name": "Drafty Draft Sync",
  "description": "Sync live ESPN and NFL.com fantasy-football draft picks into the Drafty dashboard.",
  "version": "0.0.0.12",
  "icons": {
    "16": "pulse-icon-16.png",
    "32": "pulse-icon-32.png",
    "128": "pulse-icon-128.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
      {
          "matches": [
            "https://fantasy.espn.com/football/draft*"
          ],
          "js": [
            "extensionSites.js",
            "espnDraftExtractor.js",
            "contentScript.js"
          ]
      },
      {
          "matches": [
            "https://fantasy.nfl.com/draftclient*"
          ],
          "js": [
            "extensionSites.js",
            "contentScript.js"
          ]
      },
      {
          "matches": [
            "https://drafty.friedchickentechnologies.com/*",
            "https://ff-draft-dashboard.vercel.app/*"
          ],
          "js": [
            "extensionSites.js",
            "contentScript.js"
          ]
      }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  }
}
