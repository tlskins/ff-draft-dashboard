# Public, compile-time production configuration. These values contain no
# secrets and are intentionally tracked so GitHub-triggered Vercel builds use
# the reviewed stateless API boundary.
# next.config.js maps this reviewed build-only value onto the public API host.
# The distinct name prevents a stale Vercel NEXT_PUBLIC_API_HOST override from
# silently replacing the release configuration.
DRAFTY_PRODUCTION_API_HOST=https://drafty-read-api-708070733429.us-east1.run.app
NEXT_PUBLIC_HISTORICAL_COMPARISON_ENABLED=true
NEXT_PUBLIC_DRAFT_DESK_ENABLED=true
NEXT_PUBLIC_DRAFT_SESSION_PERSISTENCE_ENABLED=false
NEXT_PUBLIC_ADVISOR_SNAPSHOT_PERSISTENCE_ENABLED=false
NEXT_PUBLIC_RANKING_PROFILE_PERSISTENCE_ENABLED=false
NEXT_PUBLIC_CLOUD_PROFILE_SYNC_ENABLED=true
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCmHlLNb_9mdVTj_H3HPxD11fPh6n8fjnA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ff-draft-dashboard.firebaseapp.com
